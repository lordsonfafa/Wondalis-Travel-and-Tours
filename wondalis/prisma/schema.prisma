// Wondalis database schema (PostgreSQL).
//
// Conventions used throughout:
// - Money is stored as whole integers in minor units (USD cents, GHS pesewas). Never floats.
// - USD is the base currency. Each booking locks the USD→GHS rate at booking time.
// - Things that can be calculated (seats booked, amount paid, payment status) are NOT stored.
//   They are derived from the rows that cause them, so they can never drift out of sync.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum TripType {
  GHANA
  ABROAD
}

enum TripStatus {
  DRAFT
  PUBLISHED
}

enum TripTag {
  BEACH
  HERITAGE
  FAMILY
}

enum Currency {
  USD
  GHS
}

enum PaymentMethod {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum FxMode {
  LIVE
  FIXED
}

// ───────────────────────── Trips ─────────────────────────

model Trip {
  id             String     @id @default(cuid())
  slug           String     @unique
  title          String
  destination    String // e.g. "Accra · Labadi"
  type           TripType
  tags           TripTag[]
  overview       String     @default("")
  highlights     String[]
  included       String[]
  coverImage     String
  gallery        String[]
  // Shown on the Experiences page once the trip has happened (see lib/db/trips.ts).
  videoUrls      String[]   @default([])
  recapNote      String? // a short caption or guest quote for the finished trip
  priceUsdCents  Int
  priceGhsPesewas Int // real cedi price, so Ghana trips are not just USD × rate
  depositPct     Int        @default(30)
  status         TripStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  itinerary  ItineraryDay[]
  departures Departure[]

  @@index([status, type])
}

model ItineraryDay {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  position Int // 1, 2, 3… the order shown on the trip page
  title    String
  body     String @default("")

  @@unique([tripId, position])
}

// A dated run of a trip. The same trip can leave more than once.
model Departure {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  startsOn   DateTime @db.Date
  endsOn     DateTime @db.Date
  seatsTotal Int

  bookings Booking[]

  @@index([tripId, startsOn])
}

// ───────────────────────── People ─────────────────────────

// A login. Customers, staff and the owner all sign in through this table.
// Better Auth owns the shape of User, Session, Account, Verification and RateLimit; they were
// generated with `npx auth@latest generate`, then adjusted (see notes). Passwords are NOT here:
// Better Auth stores a hash on Account.password.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // "customer" | "staff" | "owner". A plain string because Better Auth reads and writes it.
  // Only server code may change it (the sign-up form cannot set it, see lib/auth.ts).
  role          String   @default("customer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  customer         Customer?
  recordedPayments Payment[]
}

// One row per signed-in browser. Deleting a user deletes their sessions.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A way to sign in. Email + password is one Account (password holds the hash);
// Google sign-in will be another Account row for the same user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

// Email verification and password-reset tokens (used in the email step).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Counters for rate limiting sign-in attempts, shared by every server instance.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Someone who books. Separate from User because guest checkout is allowed:
// a customer can exist without ever creating a login.
model Customer {
  id               String   @id @default(cuid())
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName        String
  lastName         String
  email            String   @unique
  whatsapp         String?
  residenceCountry String // "Ghana" means In Ghana; anything else is Diaspora (derived, not stored)
  createdAt        DateTime @default(now())

  bookings Booking[]
}

// ───────────────────────── Bookings and money ─────────────────────────

model Booking {
  id           String   @id @default(cuid())
  refNumber    Int      @unique @default(autoincrement()) // shown as WTT-000123
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  departureId  String
  departure    Departure @relation(fields: [departureId], references: [id])

  totalUsdCents Int
  currency      Currency // what the customer sees and pays in
  fxRateLocked  Decimal  @db.Decimal(12, 6) // USD→GHS at booking time; never changes afterwards
  depositPct    Int // the deposit % that applied when they booked
  cancelledAt   DateTime?
  // An unpaid booking holds its seats until this moment, then they are released (see lib/booking.ts).
  // A booking with a PAID payment always holds its seats, whatever this says.
  holdExpiresAt DateTime?
  createdAt     DateTime @default(now())

  travellers Traveller[]
  instalments Instalment[]
  payments    Payment[]

  @@index([customerId])
  @@index([departureId])
}

model Traveller {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  nationality String? // passport nationality
  isLead      Boolean @default(false)
}

// What is OWED and when: "Deposit", "Instalment 1", "Balance"…
model Instalment {
  id            String    @id @default(cuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  position      Int
  label         String
  amountUsdCents Int
  dueOn         DateTime? @db.Date // null = due immediately

  payments Payment[]

  @@unique([bookingId, position])
}

// What was actually RECEIVED (or attempted). Append-only ledger: rows are never edited
// to change an amount; a mistake is fixed by a new row, so there is always an audit trail.
model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  booking        Booking       @relation(fields: [bookingId], references: [id])
  instalmentId   String?
  instalment     Instalment?   @relation(fields: [instalmentId], references: [id])
  amountUsdCents Int // value in USD, so totals add up across currencies
  currency       Currency // what the customer actually paid in
  amountMinor    Int // amount in that currency's minor unit (cents or pesewas)
  fxRate         Decimal       @db.Decimal(12, 6)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  providerRef    String?       @unique // Paystack reference; unique makes webhook handling idempotent
  note           String?
  recordedById   String? // set when staff record a manual (bank/cash) payment
  recordedBy     User?         @relation(fields: [recordedById], references: [id])
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([bookingId])
  @@index([status, createdAt])
}

// ───────────────────────── Settings ─────────────────────────

// Exactly one row (id = 1). Edited in Admin > Settings.
model Setting {
  id                Int             @id @default(1)
  baseCurrency      Currency        @default(USD)
  fxMode            FxMode          @default(LIVE)
  fixedRate         Decimal         @default(15) @db.Decimal(12, 6)
  liveRate          Decimal?        @db.Decimal(12, 6) // cached by the daily job
  liveRateUpdatedAt DateTime?
  displayCurrencies String[] // extra display-only currencies, e.g. GBP, EUR, CAD
  enabledMethods    PaymentMethod[]
  defaultDepositPct Int             @default(30)
  balanceDueDays    Int             @default(14) // days before departure
  cancellationPolicy String         @default("")
  updatedAt         DateTime        @updatedAt
}
