# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon or Supabase, or local while developing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wondalis"

# Better Auth. Generate the secret with:  npx auth@latest secret
# It signs session cookies: keep it private and different in every environment.
BETTER_AUTH_SECRET=""
# The site's public address (http://localhost:3000 while developing)
BETTER_AUTH_URL="http://localhost:3000"

# Exchange rate (USD to GHS). The daily job fetches the live rate and stores it in Settings.
# Long random string; the cron route refuses requests without it. Generate: npx auth@latest secret
CRON_SECRET=""
# Optional. Free key from exchangerate-api.com (no attribution needed). Leave empty to use the
# open endpoint, which requires crediting exchangerate-api.com somewhere on the site.
EXCHANGE_RATE_API_KEY=""
