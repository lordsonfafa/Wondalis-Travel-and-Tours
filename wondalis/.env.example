# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon or Supabase, or local while developing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wondalis"

# Better Auth. Generate the secret with:  npx auth@latest secret
# It signs session cookies: keep it private and different in every environment.
BETTER_AUTH_SECRET=""
# The site's public address (http://localhost:3000 while developing)
BETTER_AUTH_URL="http://localhost:3000"
