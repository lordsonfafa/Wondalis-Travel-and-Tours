# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (Neon or Supabase, or local while developing)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wondalis"

# Better Auth. Generate the secret with:  npx auth@latest secret
# It signs session cookies: keep it private and different in every environment.
BETTER_AUTH_SECRET=""
# The site's public address (http://localhost:3000 while developing)
BETTER_AUTH_URL="http://localhost:3000"

# Exchange rate (USD to GHS). The daily job fetches the live rate and stores it in Settings.
# Long random string; the cron route refuses requests without it. Generate: npx auth@latest secret
CRON_SECRET=""
# Optional. Free key from exchangerate-api.com (no attribution needed). Leave empty to use the
# open endpoint, which requires crediting exchangerate-api.com somewhere on the site.
EXCHANGE_RATE_API_KEY=""

# Paystack (test keys while developing: Dashboard > Settings > API Keys & Webhooks, Test mode).
# The secret key stays on the server. Never put it in client code or commit it.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Trip photo uploads (Cloudinary: cloudinary.com, free plan). Dashboard > "Go to API Keys" shows all three.
# The secret stays on the server: never commit it or paste it in chat. Without these, "Add photos" shows an error.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (Resend: resend.com). Without a key, emails are printed in the terminal instead of sent.
# To email real customers you must verify your own domain in Resend and set EMAIL_FROM to an address on it.
RESEND_API_KEY=""
EMAIL_FROM="Wondalis Travel and Tour <bookings@yourdomain.com>"
# Shown in the "seats reserved" email for bank-transfer bookings. Use \n for line breaks.
BANK_TRANSFER_DETAILS=""

# Google sign-in (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google  (add the live one too)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# "true" shows the Continue with Google button
NEXT_PUBLIC_GOOGLE_AUTH=""

# Public site address (used in the sitemap, SEO tags and emails). Defaults to BETTER_AUTH_URL.
NEXT_PUBLIC_SITE_URL=""
# Company WhatsApp number with country code, digits only (e.g. 233201234567). Shows a help link at checkout.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
